# Copia este archivo como variables de entorno en tu hosting (Render, Railway, VPS…).
# Ninguna es obligatoria para probar en local: sin SMTP el correo funciona en "modo prueba".

# Contraseña del panel /crm (mínimo 8 caracteres)
ADMIN_PASSWORD=cambia-esta-clave

# Dirección pública del sitio, sin "/" al final. Se usa en los botones de los correos.
PUBLIC_URL=https://tudominio.com

# Carpeta donde se guardan los datos (en Render/Railway apúntala al disco persistente)
DATA_DIR=./data

# Correo saliente (ejemplo con Brevo; Zoho, Google Workspace y Amazon SES también sirven)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-usuario-smtp
SMTP_PASS=tu-clave-smtp
MAIL_FROM=hola@tudominio.com

PORT=3000

# Vercel (funciones de api/): almacenamiento en Cloudinary.
# Cloudinary → Settings → API Keys → "API environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
